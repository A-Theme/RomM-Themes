{
  "name": "Overdrive",
  "author": "Aramaki",
  "version": "1.2.0",
  "colors": {
    "bg": "#100908",
    "surface": "#1D1412B8",
    "surface_raised": "#2C201FC7",
    "surface_hover": "#41312FD6",
    "border": "#584542E0",
    "text": "#F1EBEB",
    "text_strong": "#FDFDFD",
    "text_muted": "#ADA6A5",
    "text_disabled": "#726D6C",
    "text_on_accent": "#060B0F",
    "accent": "#6AB1ED",
    "accent_hover": "#91CCFF",
    "accent_alt": "#DD8A84",
    "focus_ring": "#B9DEFF",
    "success": "#6DC795",
    "warning": "#CDAE55",
    "danger": "#F0929C",
