#!/usr/bin/env bash
# Pre-commit hook: keep the generated index in step with themes/, and block
# commits that would leak a token, key, or credential file.
#
# Install:  ./scripts/install-hooks.sh
#
# or by hand:
#   ln -sf ../../scripts/pre-commit .git/hooks/pre-commit     # macOS/Linux/WSL
#   copy scripts\pre-commit .git\hooks\pre-commit             # Windows
#
# Bypass (only if you are certain):  git commit --no-verify

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT" || exit 1

RED=$'\033[0;31m'; RST=$'\033[0m'
FAIL=0

STAGED=$(git diff --cached --name-only --diff-filter=ACM)
[[ -z "$STAGED" ]] && exit 0

while IFS= read -r f; do
    case "$(basename "$f")" in
        .env|.env.local|config.json|credentials.json)
            echo "${RED}BLOCKED${RST}: $f looks like a credential file"; FAIL=1 ;;
        *.pem|*.p12|*.pfx|*.jks)
            echo "${RED}BLOCKED${RST}: $f looks like a private key"; FAIL=1 ;;
    esac
done <<< "$STAGED"

while IFS= read -r f; do
    [[ -f "$f" ]] || continue
    case "$f" in scripts/scan-secrets.sh|scripts/pre-commit) continue ;; esac
    case "$f" in *.zip|*.7z|*.jpg|*.jpeg|*.png|*.gif|*.webp) continue ;; esac
    if git show ":$f" 2>/dev/null | grep -qE '(ghp_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{22,}|AKIA[0-9A-Z]{16}|discord\.com/api/webhooks/[0-9]+/[A-Za-z0-9_-]+)'; then
        echo "${RED}BLOCKED${RST}: $f contains what looks like a token, key, or webhook URL"
        FAIL=1
    fi
    if git show ":$f" 2>/dev/null | grep -q -- '-----BEGIN [A-Z ]*PRIVATE KEY-----'; then
        echo "${RED}BLOCKED${RST}: $f contains a private key block"; FAIL=1
    fi
done <<< "$STAGED"

# --- the generated index ------------------------------------------------
# Changing a theme without regenerating manifest.json has broken main twice.
# Rather than just complaining about it, bring the index up to date and stage
# it, so a commit that touches themes/ always carries the index describing it.
if grep -qE '^themes/' <<< "$STAGED"; then
    PY=$(command -v python3 || command -v python)
    if [[ -z "$PY" ]]; then
        echo "${RED}BLOCKED${RST}: themes/ changed but no python found to regenerate manifest.json"
        FAIL=1
    else
        VALIDATE_OUT=$("$PY" scripts/validate-themes.py 2>&1)
        if [[ $? -ne 0 ]]; then
            echo "${RED}BLOCKED${RST}: theme validation failed"
            echo "$VALIDATE_OUT" | grep -E '^\[|FAILED' | head -20
            FAIL=1
        elif ! git diff --quiet -- manifest.json; then
            git add manifest.json
            echo "note: manifest.json was stale - regenerated and staged it."
        fi
    fi
fi

if [[ $FAIL -ne 0 ]]; then
    echo
    echo "Commit aborted."
    echo "If you are certain this is safe: git commit --no-verify"
    exit 1
fi
exit 0
